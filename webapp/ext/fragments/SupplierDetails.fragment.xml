<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
    <!--
      Approval "Supplier Details" = the before/after comparison, shown ONLY for UPDATE requests.

      For CREATE requests nothing has changed, and the standard "General Information" + "Address"
      sections already show the current values, so this section is hidden entirely (no duplicate
      values, no empty "Requested Changes" panel).

      For UPDATE requests it lists only the fields the requestor flagged (ChgX = changed), each as
      "Old value -> New value" with a read-only checkbox marking the change.

      Selection note: ChgX / OldX / RequestType carry no UI annotation, so autoExpandSelect does not
      put them in $select by default. The visible CheckBox (selected) and Text (text) bindings below
      are DIRECT bindings, which autoExpandSelect collects; the hidden <Text text="{RequestType}"/>
      does the same for RequestType, which is only read inside the expression binding on the section's
      visible.
    -->
    <VBox visible="{= ${RequestType} === 'UPDATE'}">
        <Text text="{RequestType}" visible="false"/>

        <Title text="Requested Changes" titleStyle="H5" class="sapUiSmallMarginBottom"/>

        <HBox visible="{= !!${ChgName}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgName}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="Supplier Name" width="9rem"/>
            <Text text="{OldName}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{SupplierName}"/>
        </HBox>

        <HBox visible="{= !!${ChgEmail}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgEmail}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="Email Address" width="9rem"/>
            <Text text="{OldEmail}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{Email}"/>
        </HBox>

        <HBox visible="{= !!${ChgContact}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgContact}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="Contact Number" width="9rem"/>
            <Text text="{OldContact}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{ContactNumber}"/>
        </HBox>

        <HBox visible="{= !!${ChgAddress}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgAddress}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="Street" width="9rem"/>
            <Text text="{OldStreet}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{Street}"/>
        </HBox>

        <HBox visible="{= !!${ChgHouse}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgHouse}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="House No." width="9rem"/>
            <Text text="{OldHouseNumber}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{HouseNumber}"/>
        </HBox>

        <HBox visible="{= !!${ChgCity}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgCity}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="City" width="9rem"/>
            <Text text="{OldCity}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{City}"/>
        </HBox>

        <HBox visible="{= !!${ChgPostal}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgPostal}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="Postal Code" width="9rem"/>
            <Text text="{OldPostalCode}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{PostalCode}"/>
        </HBox>

        <HBox visible="{= !!${ChgRegion}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgRegion}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="State / Region" width="9rem"/>
            <Text text="{OldRegion}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{Region}"/>
        </HBox>

        <HBox visible="{= !!${ChgCountry}}" alignItems="Center" class="sapUiTinyMarginBottom">
            <CheckBox selected="{ChgCountry}" enabled="false" class="sapUiTinyMarginEnd"/>
            <Label text="Country" width="9rem"/>
            <Text text="{OldCountry}" class="sapUiTinyMarginEnd"/>
            <Text text="→" class="sapUiTinyMarginEnd"/>
            <Text text="{Country}"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>
