<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout">
    <!--
      Approver "Supplier Details" - FS two-panel layout.
      LEFT  "Supplier Data": every field with its current value. For a changed field this is the OLD
            value (the state before the request); otherwise the current value. For a CREATE request
            nothing is flagged, so the left simply shows the new supplier data.
      RIGHT "Requested Changes": only the fields the requestor flagged (ChgX), each marked with a green
            check and its NEW value. Empty for CREATE (an info strip explains it is a brand-new supplier).
    -->
    <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="2" vSpacing="0" class="sapUiSmallMargin">

        <!-- ============ LEFT: current supplier data ============ -->
        <VBox>
            <Title text="Supplier Data" titleStyle="H5" class="sapUiSmallMarginBottom"/>

            <Label text="Name &amp; Contact" design="Bold" class="sapUiSmallMarginBottom"/>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="Supplier Name" width="9rem"/>
                <Text text="{= !!${ChgName} ? ${OldName} : ${SupplierName}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="Email Address" width="9rem"/>
                <Text text="{= !!${ChgEmail} ? ${OldEmail} : ${Email}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="Contact Number" width="9rem"/>
                <Text text="{= !!${ChgContact} ? ${OldContact} : ${ContactNumber}}"/>
            </HBox>

            <Label text="Address" design="Bold" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="Street" width="9rem"/>
                <Text text="{= !!${ChgAddress} ? ${OldStreet} : ${Street}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="House No." width="9rem"/>
                <Text text="{= !!${ChgHouse} ? ${OldHouseNumber} : ${HouseNumber}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="City" width="9rem"/>
                <Text text="{= !!${ChgCity} ? ${OldCity} : ${City}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="Postal Code" width="9rem"/>
                <Text text="{= !!${ChgPostal} ? ${OldPostalCode} : ${PostalCode}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="State / Region" width="9rem"/>
                <Text text="{= !!${ChgRegion} ? ${OldRegion} : ${Region}}"/>
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
                <Label text="Country" width="9rem"/>
                <Text text="{= !!${ChgCountry} ? ${OldCountry} : ${SupplierCountry}}"/>
            </HBox>
        </VBox>

        <!-- ============ RIGHT: requested changes (changed fields only) ============ -->
        <VBox>
            <Title text="Requested Changes" titleStyle="H5" class="sapUiSmallMarginBottom"/>

            <MessageStrip
                visible="{= ${RequestType} === 'CREATE'}"
                text="Brand-new supplier - all data on the left is being created (no prior values to compare)."
                type="Information"
                showIcon="true"
                class="sapUiTinyMarginBottom"/>

            <HBox visible="{= !!${ChgName}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="Supplier Name" width="9rem"/>
                <ObjectStatus text="{SupplierName}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgEmail}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="Email Address" width="9rem"/>
                <ObjectStatus text="{Email}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgContact}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="Contact Number" width="9rem"/>
                <ObjectStatus text="{ContactNumber}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgAddress}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="Street" width="9rem"/>
                <ObjectStatus text="{Street}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgHouse}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="House No." width="9rem"/>
                <ObjectStatus text="{HouseNumber}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgCity}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="City" width="9rem"/>
                <ObjectStatus text="{City}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgPostal}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="Postal Code" width="9rem"/>
                <ObjectStatus text="{PostalCode}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgRegion}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="State / Region" width="9rem"/>
                <ObjectStatus text="{Region}" state="Information"/>
            </HBox>
            <HBox visible="{= !!${ChgCountry}}" alignItems="Center" class="sapUiTinyMarginBottom">
                <core:Icon src="sap-icon://accept" color="Positive" class="sapUiTinyMarginEnd"/>
                <Label text="Country" width="9rem"/>
                <ObjectStatus text="{SupplierCountry}" state="Information"/>
            </HBox>
        </VBox>
    </l:Grid>
</core:FragmentDefinition>
