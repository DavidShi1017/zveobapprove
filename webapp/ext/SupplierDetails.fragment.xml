<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <!--
      Approver "Supplier Details": single-panel layout showing the supplier's current data.
      (old-vs-new comparison is a Phase 2 UPDATE feature; not ported yet.)
    -->
    <VBox class="sapUiSmallMargin">
        <Title text="Supplier Data" titleStyle="H5" class="sapUiSmallMarginBottom"/>

        <Label text="Name &amp; Contact" design="Bold" class="sapUiSmallMarginBottom"/>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="Supplier Name" width="9rem"/>
            <Text text="{SupplierName}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="Email Address" width="9rem"/>
            <Text text="{Email}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="Contact Number" width="9rem"/>
            <Text text="{ContactNumber}"/>
        </HBox>

        <Label text="Address" design="Bold" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="Street" width="9rem"/>
            <Text text="{Street}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="House No." width="9rem"/>
            <Text text="{HouseNumber}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="City" width="9rem"/>
            <Text text="{City}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="Postal Code" width="9rem"/>
            <Text text="{PostalCode}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="State / Region" width="9rem"/>
            <Text text="{Region}"/>
        </HBox>
        <HBox class="sapUiTinyMarginBottom">
            <Label text="Country" width="9rem"/>
            <Text text="{Country}"/>
        </HBox>
    </VBox>
</core:FragmentDefinition>
